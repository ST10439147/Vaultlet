{
  "manifest_version": 3,
  "name": "Vaultlet",
  "version": "0.1.0",
  "description": "Fill and copy logins from your local Vaultlet vault.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Vaultlet" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" } }
  }
}
